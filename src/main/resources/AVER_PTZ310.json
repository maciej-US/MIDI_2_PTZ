{

  "cameraName": "AVER_PTZ310",

  "transport": {

    "packetType": {
      "size": 2,
      "offset": 0,
      "types": {
        "command": ["01","00"],
        "inquiry": ["01","10"],
        "response": ["01","11"]
      }
    },

    "payloadSize": {
      "size": 2,
      "offset": 2
    },

    "sequence": {
      "type": "incremental",
      "size": 4,
      "offset": 4
    },

    "payload":{
      "offset": 8,
      "maxSize": 16
    }
  },

  "commands": {
    "absolutePosition": {
      "type": "command",
      "description": "Pan/Tilt Drive Absolute Position",
      "commandTemplate": [
        "81",
        "01",
        "06",
        "02",
        "{panSpeed}",
        "{tiltSpeed}",
        "{panPosition}",
        "{tiltPosition}",
        "FF"
      ]
    },

    "movePanTilt": {
      "type": "command",
      "description": "Pan/Tilt Drive",
      "commandTemplate": [
        "81",
        "01",
        "06",
        "01",
        "{panSpeed}",
        "{tiltSpeed}",
        "{panDirection}",
        "{tiltDirection}",
        "FF"
      ]
    },

    "stopPanTilt": {
      "type": "command",
      "description": "Stop PAN/TILT movement",
      "commandTemplate": [
        "81",
        "01",
        "06",
        "01",
        "08",
        "08",
        "03",
        "03",
        "FF"
      ]
    },

    "absoluteZoom": {
      "type": "command",
      "description": "Move zoom to absolute position",
      "commandTemplate": [
        "81",
        "01",
        "04",
        "47",
        "{zoomPosition}",
        "FF"
      ]
    },

    "exposureCompensation": {
      "type": "command",
      "description": "Exposure Compensation Up/Down",
      "commandTemplate": [
        "81",
        "01",
        "04",
        "0E",
        "{direction}",
        "FF"
      ]
    },

    "exposureGain": {
      "type": "command",
      "description": "Exposure Gain Up/Down",
      "commandTemplate": [
        "81",
        "01",
        "04",
        "0C",
        "{direction}",
        "FF"
      ]
    },

    "exposureShutter": {
      "type": "command",
      "description": "Exposure Shutter Up/Down",
      "commandTemplate": [
        "81",
        "01",
        "04",
        "0A",
        "{direction}",
        "FF"
      ]
    },

    "exposureIris": {
      "type": "command",
      "description": "Exposure Iris Up/Down",
      "commandTemplate": [
        "81",
        "01",
        "04",
        "0B",
        "{direction}",
        "FF"
      ]
    },

    "exposureMode": {
      "type": "command",
      "description": "Switch AutoEzposure Mode",
      "commandTemplate": [
        "81",
        "01",
        "04",
        "39",
        "{exposureMode}",
        "FF"
      ]
    },

    "recallPreset": {
      "type": "command",
      "description": "Camera preset and special function recall",
      "commandTemplate": [
        "81",
        "01",
        "04",
        "3F",
        "02",
        "{presetId}",
        "FF"
      ]
    },

    "panTiltPositionRequest": {
      "type": "inquiry",
      "description": "Read current PAN/TILT position",
      "commandTemplate": [
        "81",
        "09",
        "06",
        "12",
        "FF"
      ],
      "responsetype": "field",
      "responseTemplate": [
          "C0",
          "50",
          "{panPosition}",
          "{tiltPosition}",
          "FF"
        ]
    },

    "zoomPosition" : {
      "type": "inquiry",
      "description": "Read current ZOOM position",
      "commandTemplate": [
        "81",
        "09",
        "04",
        "47",
        "FF"
      ],
      "responsetype": "field",
      "responseTemplate": [
        "C0",
        "50",
        "{zoomPosition}",
        "FF"
      ]
    },

    "exposureCompensationPosition": {
      "type": "inquiry",
      "description": "Exposure Compensation Position Inquiry",
      "commandTemplate": [
        "81",
        "09",
        "04",
        "4E",
        "FF"
      ],
      "responsetype" : "field",
      "responseTemplate": [
        "10",
        "50",
        "00",
        "00",
        "{exposureCompensationPosition}",
        "FF"
      ]
    },

    "exposureGainPosition": {
      "type": "inquiry",
      "description": "Exposure Gain Position Inquiry",
      "commandTemplate": [
        "81",
        "09",
        "04",
        "4C",
        "FF"
      ],
      "responsetype" : "field",
      "responseTemplate": [
        "10",
        "50",
        "00",
        "00",
        "{exposureGainPosition}",
        "FF"
      ]
    },

    "exposureShutterPosition": {
      "type": "inquiry",
      "description": "Exposure Shutter Position Inquiry",
      "commandTemplate": [
        "81",
        "09",
        "04",
        "4A",
        "FF"
      ],
      "responsetype" : "field",
      "responseTemplate": [
        "10",
        "50",
        "00",
        "00",
        "{exposureShutterPosition}",
        "FF"
      ]
    },

    "exposureIrisPosition": {
      "type": "inquiry",
      "description": "Exposure Iris Position Inquiry",
      "commandTemplate": [
        "81",
        "09",
        "04",
        "4B",
        "FF"
      ],
      "responsetype" : "field",
      "responseTemplate": [
        "10",
        "50",
        "00",
        "00",
        "{exposureIrisPosition}",
        "FF"
      ]
    },

    "powerStatusRequest": {
      "type": "inquiry",
      "description": "Power status inquiry",
      "commandTemplate": [
        "81",
        "09",
        "04",
        "00",
        "FF"
      ],
      "responseType": "enum",
      "responseTemplate":[
        "10",
        "50",
        "{powerStatus}",
        "FF"
      ]
    },

    "interfaceClear": {
      "type": "command",
      "description": "VISCA interface clear",
      "commandTemplate": [
        "88",
        "01",
        "00",
        "01",
        "FF"
      ]
    }
  },

  "fields": {
    "panSpeed": {
      "description": "PAN speed",
      "encoding": {
        "type": "byte"
      },

      "range": {
        "min": 1,
        "max": 24
      },

      "mapping": {
        "type" : "lookup",
        "unit": "degPerSec",
        "values": {
            "1": 1,
            "2": 2,
            "3": 4,
            "4": 7,
            "5": 10,
            "6": 14,
            "7": 18,
            "8": 21,
            "9": 23,
            "10": 24
          }
      },

      "default": "0C"
    },

    "tiltSpeed": {

      "description": "TILT speed",

      "encoding": {
        "type": "byte"
      },

      "range": {
        "min": 1,
        "max": 24
      },

      "mapping": {
        "type": "lookup",
        "values": {
          "01": 0.1,
          "02": 0.2,
          "03": 0.5,
          "04": 0.8,
          "05": 1.2,
          "06": 1.8,
          "07": 2.5,
          "08": 3.5,
          "09": 5.0,
          "0A": 7.0,
          "0B": 9.5,
          "0C": 12.5,
          "0D": 16.0,
          "0E": 20.0,
          "0F": 25.0,
          "10": 31.0,
          "11": 38.0,
          "12": 46.0,
          "13": 55.0,
          "14": 65.0,
          "15": 76.0,
          "16": 88.0,
          "17": 95.0,
          "18": 100.0
        },

        "unit": "degPerSec"
      },

      "default": "0C"
    },

    "panPosition": {

      "description": "PAN position",

      "encoding": {
        "type": "visca-nibble",
        "segments": [
          12,
          8,
          4,
          0
        ]
      },

      "mapping": {

        "type": "signed-center",

        "deviceRange": {
          "negativeLimit": "8A14",
          "neutral": "0000",
          "positiveLimit": "762C"
        },

        "mechanicalRange": {
          "minDegrees": -170.0,
          "neutralDegrees": 0.0,
          "maxDegrees": 170.0
        },

        "unit": "degree"
      }
    },

    "tiltPosition": {

      "description": "TILT position",

      "encoding": {
        "type": "visca-nibble",
        "segments": [
          12,
          8,
          4,
          0
        ]
      },

      "mapping": {

        "type": "circular",

        "deviceRange": {
          "downLimit": "80AE",
          "neutral": "0000",
          "upLimit": "7FFF"
        },

        "mechanicalRange": {
          "minDegrees": -30.0,
          "neutralDegrees": 0.0,
          "maxDegrees": 90.0
        },

        "unit": "degree"
      }
    },

    "panDirection": {
      "encoding": {
        "type": "byte"
      }
    },

    "tiltDirection": {
      "encoding": {
        "type": "byte"
      }
    },

    "zoomPosition": {

      "description": "ZOOM position",

      "encoding": {
        "type": "visca-nibble",
        "segments": [
          12,
          8,
          4,
          0
        ]
      },

      "mapping": {

        "type": "unsigned",
        "deviceRange": {
          "min": "0000",
          "max": "6F20"
        },
        "mechanicalRange": {
          "min": 0,
          "max": 21252
        },
        "unit": "zoom"
      }
    },

    "direction": {
      "description": "UP and DOWN mappings for exposure parameters",
      "encoding": {
        "type": "mapping",
        "mapping": {
          "up": 2,
          "down": 3
        }
      }
    },

    "exposureMode": {
      "description" : "Auto Exposure mode switching mapping",
      "type": "unsigned",
      "encoding": {
        "type": "mapping",
        "mapping": {
          "AUTO": 0,
          "MANUAL": 3,
          "SHUTTER_PRIORITY": 10,
          "IRIS_PRIORITY": 11,
          "BRIGHT:": 13
        }
      }
    },

    "exposureCompensationPosition": {
      "description": "Exposure compensation value",
      "encoding": {
        "type": "visca-nibble",
        "segments": [4,0]
      },
      "range": {
        "min": 0,
        "max": 56
      },

      "mapping": {
        "type": "lookup",
        "mappedMin" : -4,
        "mappedMax": 4,

        "step": 1,

        "values": {
          "-4": 0,
          "-3": 7,
          "-2": 14,
          "-1": 21,
          "0": 28,
          "1": 35,
          "2": 42,
          "3": 49,
          "4": 56
        },

        "labels": {
          "-4": "-4",
          "-3": "-3",
          "-2": "-2",
          "-1": "-1",
          "0": "0",
          "1": "+1",
          "2": "+2",
          "3": "+3",
          "4": "+4"
        }
      }
    },

