          "0E": 20.0,
          "0F": 25.0,
          "10": 31.0,
          "11": 38.0,
          "12": 46.0,
          "13": 55.0,
          "14": 65.0,
          "15": 76.0,
          "16": 88.0,
          "17": 95.0,
          "18": 100.0
        },

        "unit": "degPerSec"
      },

      "default": "0C"
