      "encoding": {
        "type": "visca-nibble",
        "segments": [
          4,
          0
        ]
      },

      "mapping": {
        "type": "lookup",

        "mappedMin": 0,
        "mappedMax": 13,

        "values": {
          "0": 4,
          "1": 9,
          "2": 14,
          "3": 19,
