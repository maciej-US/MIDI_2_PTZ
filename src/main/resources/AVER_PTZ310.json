      "description" : "Gain position values",
      "encoding": {
        "type": "visca-nibble",
        "segments": [4,0]
      },

    "range": {
      "min": 0,
      "max": 64
    },

      "mapping": {
        "type": "lookup",
        "mappedMin": 0,
        "mappedMax": 14,
        "step" : 3,
