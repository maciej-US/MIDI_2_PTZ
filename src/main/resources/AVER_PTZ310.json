          "11": "F2.0",
          "12": "F1.6"
        }
      }
    },


    "powerStatus": {
      "type": "enum",
      "mapping": {
        "02": "ON",
        "03": "OFF"
      }
    },

    "presetId": {
      "type": "uint8",

      "encoding": {
        "type": "byte"
      },

      "range": {
        "min": 0,
        "max": 255
      },

      "mapping": {
        "smartShoot_On": 168,
        "smartShoot_Off": 169,

        "tally_On": 96,
        "tally_Off": 97
      }
    }
