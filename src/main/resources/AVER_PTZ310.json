    "panPosition": {

      "description": "PAN position",

      "encoding": {
        "type": "visca-nibble",
        "segments": [
          12,
          8,
          4,
          0
        ]
      },

      "mapping": {

        "type": "signed-center",

        "deviceRange": {
          "negativeLimit": "8A14",
          "neutral": "0000",
          "positiveLimit": "762C"
        },

        "mechanicalRange": {
          "minDegrees": -170.0,
          "neutralDegrees": 0.0,
          "maxDegrees": 170.0
        },

        "unit": "degree"
      }
    },

    "tiltPosition": {

      "description": "TILT position",

      "encoding": {
        "type": "visca-nibble",
        "segments": [
          12,
          8,
          4,
          0
        ]
      },

      "mapping": {

        "type": "circular",

        "deviceRange": {
          "downLimit": "80AE",
          "neutral": "0000",
